{
    "$help": "https://aka.ms/terminal-documentation",
    "$schema": "https://aka.ms/terminal-profiles-schema",
    "actions": [
        {
            "name": "Copy previous command output",
            "keys": "ctrl+shift+c",
            "command": {
                "action": "multipleActions",
                "actions": [
                    { "action": "selectOutput", "direction": "prev" },
                    { "action": "copy", "singleLine": false }
                ]
            }
        }
    ]
}
